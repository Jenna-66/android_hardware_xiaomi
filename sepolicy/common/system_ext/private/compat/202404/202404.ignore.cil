;; new_objects - a collection of types that have been introduced that have no
;;   analogue in older policy.  Thus, we do not need to map these types to
;;   previous ones.  Add here to pass checkapi tests.
(type new_objects)
(typeattribute new_objects)
(typeattributeset new_objects
  ( new_objects
    vendor_thermal_normal_prop
    hal_dms_hwservice
    hal_xiaomi_displayfeature_hwservice
    hal_xiaomi_touchfeature_hwservice
    ir_device
    sysfs_backlight
    touchfeature_device
    vendor_hal_xiaomi_citsensorservice_service
    vendor_hal_xiaomi_mlipay_hwservice
    vendor_hal_xiaomi_motor_hwservice
    ))
